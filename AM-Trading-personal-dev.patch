+void NotesScreen::populate_template_note(const QString& title, const QString& category, const QString& priority,
+                                         const QString& sentiment, const QString& tags, const QString& content) {
+    selected_note_id_ = -1;
+    clear_editor();
+    edit_title_->setText(title);
+    edit_content_->setPlainText(content);
+
+    const int cat_idx = edit_category_->findData(category);
+    if (cat_idx >= 0)
+        edit_category_->setCurrentIndex(cat_idx);
+
+    edit_priority_->setCurrentText(priority);
+    edit_sentiment_->setCurrentText(sentiment);
+    edit_tags_->setText(tags);
+    edit_tickers_->clear();
+
+    is_editing_ = true;
+    right_stack_->setCurrentIndex(2);
+}
